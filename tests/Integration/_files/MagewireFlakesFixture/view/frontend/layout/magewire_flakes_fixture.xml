<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="root">
            <container name="magewire.flakes.fixture"/>
        </referenceContainer>

        <referenceContainer name="magewire.flakes.fixture">
            <block name="message"
                   template="Magewirephp_MagewireFlakesFixture::flakes/message.phtml">
                <arguments>
                    <argument name="flake" xsi:type="array">
                        <item name="family" xsi:type="string">fixture-message</item>
                        <item name="props" xsi:type="array">
                            <item name="tone" xsi:type="string">neutral</item>
                        </item>
                        <item name="children" xsi:type="array">
                            <item name="html" xsi:type="string">@html</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
