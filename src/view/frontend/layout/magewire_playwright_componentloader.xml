                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\Magewire\Magewire\Playwright\ComponentLoader\Listener
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
