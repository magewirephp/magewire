        <referenceContainer name="content">
            <block name="magewire.playwright.component-loader.origin"
                   template="Magewirephp_Magewire::tests/magewire/playwright/component_loader/origin.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\Magewire\Magewire\Playwright\ComponentLoader\Origin
                    </argument>
                </arguments>
            </block>
            <block name="magewire.playwright.component-loader.listener"
