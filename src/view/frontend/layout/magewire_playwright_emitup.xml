<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
      layout="1column"
>
    <body>
        <referenceContainer name="content">
            <!-- grandparent > parent > (child, sibling), and an unrelated stranger. -->
            <block name="magewire.playwright.emit-up.grandparent"
                   template="Magewirephp_Magewire::tests/magewire/playwright/backwards_compatibility/emit_up/node.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node
                    </argument>
                </arguments>
                <block name="magewire.playwright.emit-up.parent"
                       template="Magewirephp_Magewire::tests/magewire/playwright/backwards_compatibility/emit_up/node.phtml"
                >
                    <arguments>
                        <argument name="magewire" xsi:type="object" shared="false">
                            Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node
                        </argument>
                    </arguments>
                    <block name="magewire.playwright.emit-up.child"
                           template="Magewirephp_Magewire::tests/magewire/playwright/backwards_compatibility/emit_up/node.phtml"
                    >
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node
                            </argument>
                        </arguments>
                    </block>
                    <block name="magewire.playwright.emit-up.sibling"
                           template="Magewirephp_Magewire::tests/magewire/playwright/backwards_compatibility/emit_up/node.phtml"
                    >
                        <arguments>
                            <argument name="magewire" xsi:type="object" shared="false">
                                Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node
                            </argument>
                        </arguments>
                    </block>
                </block>
            </block>
            <block name="magewire.playwright.emit-up.stranger"
                   template="Magewirephp_Magewire::tests/magewire/playwright/backwards_compatibility/emit_up/node.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object" shared="false">
                        Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
