declare(strict_types=1);

// Alpine component used by the alpine_placeholder.phtml placeholder root. Registered by
// name so the placeholder needs no inline expression, keeping it CSP compatible.
?>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('magewireLazyProbe', () => ({ probe: 'alive' }));
    }, { once: true });
</script>