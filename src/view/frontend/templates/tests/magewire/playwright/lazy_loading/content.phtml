declare(strict_types=1);

/** @var \Magewirephp\Magewire\Magewire\Playwright\LazyLoading\Basic $magewire */
?>
<div>
    <div data-testid="lazy-content">
        <h2 class="text-lg mb-2 font-bold">Lazy content loaded</h2>

        <p data-testid="lazy-mounted"><?= $magewire->mounted ? 'mounted' : 'not-mounted' ?></p>

        <?php /* Interaction after a lazy load: both round-trip through the hydrated component. */ ?>
        <button type="button" data-testid="lazy-increment" wire:click="increment">Increment</button>
        <p data-testid="lazy-count"><?= (int) $magewire->count ?></p>

        <label>
            <input type="checkbox" data-testid="lazy-checkbox" wire:model.live="checked"/>
            Checked
        </label>
        <p data-testid="lazy-checked"><?= $magewire->checked ? 'checked' : 'unchecked' ?></p>
    </div>
</div>
