declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\Magewire\Playwright\BackwardsCompatibility\EmitUp\Node;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var Node $magewire */
?>
<div data-testid="<?= $escaper->escapeHtmlAttr($block->getNameInLayout()) ?>">
    <p data-testid="received"><?= (int) $magewire->received ?></p>
    <p data-testid="rendered"><?= $escaper->escapeHtml((string) hrtime(true)) ?></p>
    <button type="button" data-testid="pick" wire:click="pick">Emit up</button>
    <button type="button" data-testid="pick-self" wire:click="pickSelf">Emit up to self</button>
    <button type="button" data-testid="pick-stranger" wire:click="pickStranger">Emit up to the stranger</button>
    <button type="button" data-testid="refresh-up" wire:click="refreshUp">Refresh up</button>
    <button type="button" data-testid="broadcast" wire:click="broadcast">Dispatch</button>
    <?= $block->getChildHtml() ?>
</div>
