$preview = $block->getData('preview');
$exceptionBlock = $block->getChildBlock('exception');
$exceptionHtml = '';

if ($exceptionBlock instanceof AbstractBlock && $preview instanceof UiPreview) {
    $exceptionHtml = $exceptionBlock->setData('application_state', $preview->applicationState())->setData('exception', $preview->exception())->toHtml();
}
