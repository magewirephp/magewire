    <script>
        (() => {
            'use strict';

            const initialize = () => {
                const root = document.querySelector('[data-testid="ui-workbench"]');
                const notifier = window.MagewireAddons?.notifier;

                if (! root || ! notifier || root.dataset.notificationsInitialized === 'true') {
                    return;
                }

                root.dataset.notificationsInitialized = 'true';

                const persistent = root.querySelector('[data-testid="ui-notifications-persistent"]');
                const duration = root.querySelector('[data-testid="ui-notifications-duration"]');
                const show = root.querySelector('[data-testid="ui-notifications-show"]');
                const clear = root.querySelector('[data-testid="ui-notifications-clear"]');
                const count = root.querySelector('[data-testid="ui-notification-count"]');
                const mode = root.querySelector('[data-testid="ui-notification-mode"]');
                const query = new URLSearchParams(window.location.search);

                persistent.checked = query.get('persistent') !== '0';
                duration.disabled = persistent.checked;

                if (query.has('duration')) {
                    duration.value = Math.max(250, Number(query.get('duration')) || 4000);
                }

                const renderStatus = () => {
                    const active = notifier.notifications.filter(notification => notification.active).length;
                    count.textContent = String(active);
                    mode.textContent = persistent.checked
                        ? 'Notifications remain visible until dismissed.'
                        : `Notifications close after ${duration.value} ms.`;
                };

                const clearNotifications = async () => {
                    for (const notification of [...notifier.notifications]) {
                        await notifier.terminate(notification.id);
                    }

                    notifier.notifications.splice(0, notifier.notifications.length);
                    renderStatus();
                };

                const createNotification = async (notification, occurrences = 1) => {
                    const options = {
                        title: notification.title,
                        type: notification.type,
                        duration: persistent.checked ? false : Math.max(250, Number(duration.value) || 4000),
                        loader: { active: notification.loading === true }
                    };

                    for (let occurrence = 0; occurrence < occurrences; occurrence += 1) {
                        await notifier.create(notification.message, options);
                    }
                };

                const showNotifications = async () => {
                    show.disabled = true;

                    try {
                        await clearNotifications();
                        await createNotification({
                            type: 'success',
                            title: 'Changes saved',
                            message: 'The component completed successfully.'
                        });
                        await createNotification({
                            type: 'info',
                            title: 'Request running',
                            message: 'The activity indicator remains available to theme authors.',
                            loading: true
                        }, 2);
                        await createNotification({
                            type: 'warning',
                            title: 'Repeated warning',
                            message: 'This notification demonstrates an emphasized occurrence badge.'
                        }, 11);
                        await createNotification({
                            type: 'error',
                            title: 'Action failed',
                            message: 'The component could not complete the requested action.'
                        });
                    } finally {
                        show.disabled = false;
                        renderStatus();
                    }
                };

                persistent.addEventListener('change', () => {
                    duration.disabled = persistent.checked;
                    renderStatus();
                });
                duration.addEventListener('change', renderStatus);
                show.addEventListener('click', showNotifications);
                clear.addEventListener('click', clearNotifications);

                const notifierElement = document.querySelector('.magewire-notifier');
                if (notifierElement) {
                    new MutationObserver(renderStatus).observe(notifierElement, {
                        attributes: true,
                        childList: true,
                        subtree: true
                    });
                }

                showNotifications();
            };

            document.addEventListener('alpine:initialized', initialize, { once: true });
            document.addEventListener('livewire:initialized', initialize, { once: true });

            if (window.Alpine && window.MagewireAddons?.notifier) {
                queueMicrotask(initialize);
            }
        })();
    </script>
