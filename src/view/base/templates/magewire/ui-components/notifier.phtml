<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\AbstractBlock;
use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\ViewModel\Magewire as MagewireViewModel;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var MagewireViewModel $magewireViewModel */
/** @var AbstractBlock|false $notificationsBeforeBlock */
/** @var AbstractBlock|false $notificationsAfterBlock */

$notificationsBeforeBlock = $block->getChildBlock('notification.before');
$notificationsAfterBlock = $block->getChildBlock('notification.after');

$magewireViewModel = $block->getData('view_model');
$templateUtil = $magewireViewModel->utils()->template();
$layoutUtil = $magewireViewModel->utils()->layout();
?>
<?= $templateUtil->echoCodeComment('notifier', false, 'UI Component') ?>
<div x-data="magewireNotifier" x-bind="magewireNotifierBindings">
    <template x-for="notification in notifications">
        <div
            aria-busy="true"
            aria-label="off"
            role="status"
            x-show="notification.active"
            x-transition:enter="magewire-notifier-transition-enter"
            x-transition:enter-start="magewire-notifier-transition-enter-start"
            x-transition:enter-end="magewire-notifier-transition-enter-end"
            x-transition:leave="magewire-notifier-transition-leave"
            x-transition:leave-start="magewire-notifier-transition-leave-start"
            x-transition:leave-end="magewire-notifier-transition-leave-end"
            x-bind="bindings.notification.item.root"
        >
            <span
                class="magewire-notifier-occurrences"
                x-bind="bindings.notification.item.occurrences"
            >
                <span class="magewire-sr-only">
                    <?= $escaper->escapeHtml(__('Notification occurrences:')) ?>
                </span>
                <span aria-hidden="true" x-text="notification.occurrences">
                    <!-- Notification occurrence count placeholder. -->
                </span>
            </span>

            <?php if ($layoutUtil->canContainerizeBlock($notificationsBeforeBlock)): ?>
                <div class="magewire-notifier-before">
                    <?= $layoutUtil->renderBlockAsContainer($notificationsBeforeBlock) ?>
                </div>
            <?php endif ?>

            <div class="magewire-notifier-body">
                <p class="magewire-notifier-title" x-show="notification.title">
                    <strong x-text="notification.title">
                        <!-- Notification title placeholder. -->
                    </strong>
                </p>

                <p class="magewire-notifier-message"
                   x-text="notification.message"
                   x-show="notification.message"
                >
                    <!-- Notification message placeholder. -->
                </p>
            </div>

            <?php if ($layoutUtil->canContainerizeBlock($notificationsAfterBlock)): ?>
                <div class="magewire-notifier-after">
                    <?= $layoutUtil->renderBlockAsContainer($notificationsAfterBlock) ?>
                </div>
            <?php endif ?>
        </div>
    </template>
</div>
