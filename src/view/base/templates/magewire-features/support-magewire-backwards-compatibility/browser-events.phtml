<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magewirephp\Magewire\ViewModel\Magewire as MagewireViewModel;

/** @var Template $block */
/** @var MagewireViewModel $magewireViewModel */

$magewireViewModel = $block->getData('view_model');
$magewireFragment = $magewireViewModel->utils()->fragment();

/** @internal Do not modify to ensure Magewire continues to function correctly. */
?>
<?php $script = $magewireFragment->make()->script()->start() ?>
<script>
    <?php /* Events from the deprecated dispatchBrowserEvent() keep their Magewire 1 shape: the
     * payload is event.detail as is ({} when empty), where Livewire's dispatch() would wrap a
     * string in an array. Modern dispatch() calls are not touched. */ ?>
    document.addEventListener('magewire:init', () => {
        Magewire.hook('effect', ({ component, effects }) => {
            const dispatches = effects.bc?.dispatches ?? [];

            if (dispatches.length === 0) {
                return;
            }

            <?php /* Same delay as Livewire's own dispatches, so listeners see the morphed DOM. */ ?>
            queueMicrotask(() => queueMicrotask(() => queueMicrotask(() => {
                dispatches.forEach(({ event, data }) => {
                    component.el.dispatchEvent(new CustomEvent(event, { bubbles: true, detail: data ? data : {} }));
                });
            })));
        });
    });
</script>
<?php $script->end() ?>
